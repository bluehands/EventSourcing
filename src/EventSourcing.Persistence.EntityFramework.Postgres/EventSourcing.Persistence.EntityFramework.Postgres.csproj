<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Bluehands.EventSourcing.Persistence.Postgres</PackageId>
    <Title>Bluehands.EventSourcing.Persistence.Postgres</Title>
    <PackageDescription>PostgreSQL persistence for EventSourcing</PackageDescription>
    <PackageTags>EventSourcing,CQRS,EventStore,Postgres,EntityFramework</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../EventSourcing.Persistence.EntityFramework/EventSourcing.Persistence.EntityFramework.csproj" />
  </ItemGroup>
</Project>
