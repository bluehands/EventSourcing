<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.3" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SignAssembly>false</SignAssembly>
    <IsPackable>false</IsPackable>
    <UserSecretsId>EventSourcing-Playground-Meetup-AppHost</UserSecretsId>
    <!-- Keep dotnet run self-contained through NuGet-restored orchestration tools. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.3" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.3" />
    <ProjectReference Include="../Meetup/Meetup.csproj" />
  </ItemGroup>
</Project>
