<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	
	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>Bluehands.EventSourcing.Persistence.SqlServer</PackageId>		
		<Titel>Bluehands.EventSourcing.Persistence.SqlServer</Titel>
		<PackageTags>EventSourcing,CQRS,EventStore,SqlServer,EntityFramework</PackageTags>
		<PackageDescription>SqlServer persistence for EventSourcing</PackageDescription>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
		<PackageReference Include="System.Linq.Async" Version="7.0.1" />		
		<!-- Security override for Microsoft.Data.SqlClient 6.1.7.
		     Remove when SqlClient transitively resolves PKCS >= 9.0.21 (9.x) or >= 10.0.13 (10.x),
		     then rerun the vulnerability scan without this override.
		     https://github.com/advisories/GHSA-846f-f764-76mx
		     https://github.com/advisories/GHSA-2fmv-rv2c-59x7 -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\EventSourcing.Persistence.EntityFramework\EventSourcing.Persistence.EntityFramework.csproj" />
	</ItemGroup>
</Project>
